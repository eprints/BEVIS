#!/usr/bin/perl -w

use FindBin;
use lib "$FindBin::Bin/../../..//perl_lib";

######################################################################
#
#
######################################################################

=pod

=for Pod2Wiki

=head1 NAME

B<generate_apacheconf_for_anubis> - Create the apache config files needed for EPrints, including diversion via Anubis

=head1 SYNOPSIS

B<generate_apacheconf_for_anubis> [B<options>]

B<generate_apacheconf_for_anubis> --undo

=head1 DESCRIPTION

This script re-generates the config files to include Anubis in your Apache configuration.

This script assumes your EPrints instance has already been configured to support HTTPS and has
an SSL specific apache config file in archive/REPO_ID/ssl/securevhost.conf as per https://wiki.eprints.org/w/How_to_use_EPrints_with_HTTPS

This script behaves like `generate_apacheconf --system --replace` and options to only regenerate partial config aren't tested.

Anubis sits in front of EPrints and selectively forwards requests to EPrints, or blocks them.

This will result in:
 - EPrints on HTTP (no SSL) on port 3000, not visible to the outside world
 - A reverse proxy on port 443 that forwards to the Anubis service on port 8923
 - Port 80 as a simple redirect to 443.
 - Anubis should be configured to forward requests to localhost:3000

Via the following config files:

/etc/httpd/conf.d/eprints.conf includes /opt/eprints3/cfg/apache.conf
/opt/eprints3/cfg/apache.conf includes /opt/eprints3/cfg/apache/*.conf
/opt/eprints3/cfg/apache/REPOID.conf  listens on port 3000
/opt/eprints3/cfg/apache/redirect.conf will redirect port 80 to 443

/etc/httpd/conf.d/eprints-ssl.conf includes /opt/eprints3/archives/*/ssl/securevhost.conf
/opt/eprints3/archives/*/ssl/securevhost.conf configures certificates and will include /opt/eprints3/cfg/apache_ssl/[REPOID].conf which will actually configure anubis

=head2 Adding to Apache Configuration

To enable EPrints you must add the following line to your main Apache
configuration file (I</etc/httpd/conf/httpd.conf>), modifying EPRINTS_PATH as appropriate :

 Include EPRINTS_PATH/cfg/apache.conf

To enable secure (HTTPS) you must add the following line to your SSL
VirtualHost, modifying EPRINTS_PATH as appropriate:

 Include EPRINTS_PATH/cfg/apache_ssl.conf

=head1 OPTIONS

=over 8

=item B<--undo>

Remove Anubis reverse proxy from the apache config.

=item B<--ratelimit>

Add config for using nginx to rate limit requests after Anubis filtering. Requires nginx installed and configured to load archive/ARCHIVEID/nginx/*.conf

=item B<--help>

Print a brief help message and exit.

=item B<--man>

Print the full manual page and then exit.

=item B<--quiet>

Be vewwy vewwy quiet. This option will suppress all output unless an error occurs.

=item B<--verbose>

Explain in detail what is going on.
May be repeated for greater effect.

=item B<--version>

Output version information and exit.

=back   

=head1 FILES

=over 4

=item B<EPRINTS/cfg/apache.conf>

Loads the EPrints environment and repository-specific configuration files.

=item B<EPRINTS/cfg/apache_ssl.conf>

Loads the repository-specific SSL configuration files.

=item B<EPRINTS/cfg/apache/[repoid].conf>

A <VirtualHost> that responds to the configured hostname and port of the
repository.

=item B<EPRINTS/cfg/apache_ssl/[repoid].conf>

A <Location> that responds to the configured https_root of the repository.

=item B<EPRINTS/archives/[repoid]/cfg.d/10_base.pl>

Default location for host and path directives used to build the Apache
configuration files.

=back


=cut


use EPrints;

use strict;
use Getopt::Long;
use Pod::Usage;
use Digest::MD5;

my $version = 0;
my $verbose = 0;
my $quiet = 0;
my $help = 0;
my $man = 0;
my $undo = 0;
my $ratelimit = 0;
my $nginxfront = 0;

Getopt::Long::Configure("permute");

GetOptions( 
	'help|?' => \$help,
	'man' => \$man,
	'version' => \$version,
	'verbose+' => \$verbose,
	'silent' => \$quiet,
	'quiet' => \$quiet,
	'undo' => \$undo,
	'ratelimit' => \$ratelimit,
) || pod2usage( 2 );
EPrints::Utils::cmd_version( "generate_apacheconf_for_anubis" ) if $version;
pod2usage( 1 ) if $help;
pod2usage( -exitstatus => 0, -verbose => 2 ) if $man;
pod2usage( 2 ) if( scalar @ARGV > 1 );

our( $repository_id ) = @ARGV;

our $noise = 1;
$noise = 0 if( $quiet );
$noise = 1+$verbose if( $verbose );


#cjg Write a more simple conf if only one language involved?

# Set STDOUT to auto flush (without needing a \n)
$|=1;

if($undo){
	print "Reverting all anubis/nginx configuration\n";
}
else{
	if ($ratelimit)
	{
		print "Generating configuration to use nginx for rate limiting as well as anubis\n";
	}else{
		print "Not using nginx, just anubis\n";
	}
}

my $shibboleth = 0;

my $eprints = EPrints->new;

# Load up the repositories
my $default_repo_id=undef;
my %reps = ();
my $found_archives = 0;
foreach my $id ( $eprints->repository_ids() )
{
	$reps{$id} = $eprints->repository( $id, db_connect => 0); 
	EPrints->abort( "Error loading $id" ) if !defined $reps{$id};
	$found_archives += 1;
	if(!defined $default_repo_id){
		$default_repo_id = $id;
	}
}

if($found_archives == 0){
	print "No configured archive found, cannot proceed\n";
	exit 1;
}


my $base_path = EPrints::Config::get( "base_path" );
my $archives_path = "$base_path/archives";
my $perl_lib = "$base_path/perl_lib";
my $apache_eprints_conf = EPrints::Config::get( "cfg_path" )."/apache.conf";
my $apache_ssl_conf = EPrints::Config::get( "cfg_path" )."/apache_ssl.conf";
my $nginx_conf_dir = "$archives_path/$default_repo_id/nginx";
my $nginx_ratelimit_conf = "$nginx_conf_dir/eprints_nginx_rate_limiting.conf";
my $perl_module_isolation = EPrints::Config::get( "perl_module_isolation" );
my $perl_module_isolation_conf = EPrints::Config::get( "cfg_path" )."/perl_module_isolation.conf";
my $perl_module_isolation_vhost_conf = EPrints::Config::get( "cfg_path" )."/perl_module_isolation_vhost.conf";

if(!-e $apache_eprints_conf){
	print "Can't find $apache_eprints_conf - has this repo previously been configured?\n";

	exit 1;
}

my $found_shibboleth = 0;

my $securevhost_file = "$archives_path/$default_repo_id/ssl/securevhost.conf";
my $securevhost_extras_file = "$archives_path/$default_repo_id/ssl/securevhost.extras.conf";
open my $securevhost, $securevhost_file or die "Could not open $securevhost_file: $!";


my $in_location_block = 0;
my $in_main_shib_location_block = 0;
my $in_a_shib_location_block = 0;
#to make shibboleth work in front of anubis, without the rest of eprints, we need to add `PerlSetVar EPrints_ArchiveID [ARCHIVE ID]`. Has this already been done?
my $archive_id_set_for_shib = 0;

my $new_securevhost_contents = "";

my $securevhost_changed = 0;
my $non_shib_location_block_contents = "";
my $found_non_shib_location_blocks = 0;
my $found_include_extras = 0;

my $include_extras_line = "Include /opt/eprints3/archives/$default_repo_id/ssl/securevhost.extras.conf";
my $keep_line = 1;

# looping through the lines of securevhost.conf, looking for location blocks to idenfity if shibboleth is configured and if there's anything which needs moving into extras
# if left here config will be loaded for the front of the anubis proxy. In securevhost.extras.conf, it will be loaded by the internal eprints instance on port 3000.
# If shibboleth is configured, will add the line `PerlSetVar EPrints_ArchiveID [ARCHIVE ID]` so that the login script can still work in front of anubis.
# It will then set the required cookies so that eprints behind anubis will recognise the user as logged in.
# shibd doesn't pass through the apache environment variables required for the login script to recognise the user if it is left on the eprints side of anubis.
while( my $line = <$securevhost>)  {   
	$keep_line = 1;

	if(index($line, "<Location") != -1){
		$in_location_block = 1;
	}
	
	if(index($line, "shibboleth") != -1){
		if(not $found_shibboleth){
			print "Looks like shibboleth is configured\n";
		}
		$found_shibboleth = 1;
		if($in_location_block){
			$in_a_shib_location_block = 1;
		}
	}

	if($in_location_block && !$in_a_shib_location_block){
		$non_shib_location_block_contents .= $line;
		$found_non_shib_location_blocks = 1;
		# future idea: could we automatically generate securevhost.extras.conf? 
		# I suspect this will be made up entirely of edge cases, so will leave to a human to do manually for now.
		# $keep_line = 0;
	}

	if(index($line, "PerlSetVar EPrints_ArchiveID") != -1){
		$archive_id_set_for_shib = 1;
		if ($in_main_shib_location_block && $undo){
			# strip the `PerlSetVar EPrints_ArchiveID` line inside this block
			$keep_line = 0;
			$securevhost_changed = 1;
			print "Stripping line from securevhost.conf: '$line'\n" if $noise >= 1;
		}
	}

	if(index($line, "PerlTransHandler") != -1){
		if (!$undo){
			# strip the `PerlTransHandler +EPrints::Apache::Rewrite` line from the file
			$keep_line = 0;
			$securevhost_changed = 1;
			print "Stripping line from securevhost.conf: '$line'\n" if $noise >= 1;
		}
	}

	if(index($line, "<Location /shibboleth") != -1 || index($line, "<Location \"/shibboleth") != -1){
		$in_main_shib_location_block = 1;
	}

	if(index($line, $include_extras_line) !=-1){
		$found_include_extras = 1;
		if (!$undo){
			#extras are included on the eprints side of anubis
			print "Removing $include_extras_line\n";
			$keep_line = 0;
		}
	}

	if(index($line, "</Location") != -1){
		if($in_main_shib_location_block){
			#reached the end of Location for the shibboleth login script
			if(!$undo && !$archive_id_set_for_shib){
				#need the `PerlSetVar EPrints_ArchiveID` line inside this block
				my $newline =  "PerlSetVar EPrints_ArchiveID $default_repo_id";
				$new_securevhost_contents.= "$newline\n";
				print "Adding line '$newline' to securevhost.conf (to support shibboleth)\n" if $noise >= 1;
				$securevhost_changed = 1;
			}
		}

		$in_location_block = 0;
		$in_main_shib_location_block = 0;
		$in_a_shib_location_block = 0;
	}

	if (index($line, "/VirtualHost") != -1 && $undo && !$found_include_extras && -e $securevhost_extras_file){
		# we're undoing anubis.
		# we're at the end of the virtualhost block 
		# extras file exists, but isn't included in securevhost, add it.
		$new_securevhost_contents .= "$include_extras_line\n";
	}

	if($keep_line){
		$new_securevhost_contents .= $line;
	}
}

close $securevhost;

if($found_archives > 1 && $found_shibboleth){
	print "Multiple archives found and shibboleth required. This is not yet supported. This script will now exit.\n";
	exit 1;
}

if(!$undo && $found_shibboleth && $found_non_shib_location_blocks){
	print "Found parts of securevhost.conf that may require moving into securevhost.extras.conf.\n";
	print "If the following block should apply to EPrints then consider moving it to $archives_path/$default_repo_id/ssl/securevhost.extras.conf and re-running generate_apacheconf_for_anubis\n";
	print "$non_shib_location_block_contents\n";
}

if ($securevhost_changed){
	print "Changed securevhost.conf, please review changes.\n" if $noise >= 1;
	print "Replacement content for securevhost.conf: \n\n\n $new_securevhost_contents\n" if $noise >= 2;
	my $backup = EPrints->system->write_config_file( $securevhost_file, $new_securevhost_contents, BACKUP => 1 );
	if( $backup )
	{
		print "Wrote $backup\n" if $noise >= 1;
	}
}


if($undo){
	print "UNDOING anubis configuration. Running generate_apacheconf --system --replace\n\n";
	print `$base_path/bin/generate_apacheconf --system --replace`;
	print "\n\n";
}

my $inc_path = "$base_path/cfg/apache";
# extra files to be included that may require customising
my $extra_inc_path = "$base_path/cfg/apache/extra";
my $inc_ssl_path = "$base_path/cfg/apache_ssl";

EPrints->system->mkdir( $inc_path );
EPrints->system->mkdir( $extra_inc_path );
EPrints->system->mkdir( $inc_ssl_path );

# we are using the same port for all hosts because they will be virtualhosts on port 3000 - allowing anubis to just forward
# everything to port 3000 and then apache sort it out to the respective eprints repositories
my $eprints_local_port = 3000;
# if nginx is running for rate limiting, it's on port 10001.
my $nginx_ratelimit_local_port = 10001;

# would like a way to be able to enable/disable the nginx rate limiting with a single script. However, there's no nice easy solution without root, and even with root
# it's a bit messy. 
# instead I think it's best to simple print to stdout instructions on how to easily switch


if( !$undo )
{
	my $extras = "";
	# search for anything which used to be in securevhost.conf, but needs to be applied to eprints rather than the anubis proxy front end.
	foreach my $id ( $eprints->repository_ids() ){
		my $extrasconf = "$archives_path/$id/ssl/securevhost.extras.conf";
		if( -e $extrasconf){
			$extras = "$extras Include $extrasconf\n";
		}
	}

	my $conf = <<END;
#
# apache.conf include file for EPrints
#
# Any changes made here will be lost if you run generate_apacheconf_for_anubis
#

# EPrints moved to be internal-only, with Anubis facing the outside world.
Listen [::1]:$eprints_local_port

# Load the perl modules & repository configurations
# note various (failed) experiments to try and prevent httpd segfaulting in mpm event mode.
# have given up and gone back to mpm prefork
#PerlSwitches -I$perl_lib
<Perl>
	use lib qw ( $perl_lib );
	use EPrints;
</Perl>
#Include $base_path/cfg/perl_module_isolation.conf
PerlPostConfigHandler +EPrints::post_config_handler

# Load the per-repository apache configuration
Include $inc_path/*.conf

$extras

END
	my $backup = EPrints->system->write_config_file( $apache_eprints_conf, $conf, BACKUP => 1 );
	if( $backup )
	{
		print "Wrote $backup\n" if $noise >= 1;
	}
	print "Wrote $apache_eprints_conf\n" if( $noise >= 1 );
}

if (!$undo)
{
	#get contents minus any line which contains "PerlTransHandler"
	my $conf = `sed '/PerlTransHandler/d' $apache_ssl_conf`;

	my $backup = EPrints->system->write_config_file( $apache_ssl_conf, $conf, BACKUP => 1 );
	if( $backup )
	{
		print "Wrote $backup\n" if $noise >= 1;
	}
	print "Wrote $apache_ssl_conf\n" if( $noise >= 1 );
}

####################################################
# 
#   Write apache conf files for each repository
#
####################################################

# Bodge - we want to call EPrints::Apache::apache_conf but we want to overide a handful of repo config options. This class lets us do just that
package FakeRepo;

sub new {
	my ($class, $real_repo, $port) = @_;
	
	my $self = bless {}, $class;

	$self->{real_repo} = $real_repo;
	$self->{port} =  $port;

	return $self;
}

sub get_id{
	my ($self) = @_;

	return $self->{real_repo}->get_id;
}

sub get_conf { return config( @_ ); }
sub config {
	my ($self, $config_name) = @_;

	if($config_name eq "port"){
		#we want to listen on http but on port 3000 (by default, can be overriden)
		return $self->{port};
	}

	if($config_name eq "http_url"){
		#pretend to be HTTP so we get the full HTTP-only config file
		return "http://literallyAnything";
	}

	if($config_name eq "aliases"){
		#pretend there aren't any aliases so we just get a virtualhost block for port 3000
		return undef;
	}

	# fall back to real config
	return $self->{real_repo}->get_conf($config_name);
}


foreach my $repository ( values %reps ) 
{
	my $id = $repository->get_id();

	#if one repo has been explicitly requested, skip all the others
	next if $repository_id && $repository_id ne $id;

	my $eprints_apache_conf_file = "$inc_path/$id.conf";

	my $eprints_apachelog_conf = "$extra_inc_path/$id.logging.conf";

	# the config file which overrides pages for HTTP 503 errors
	# plan is to copy the default so we can modify it for the repo
	my $ratelimit_errorpages_conf = "$extra_inc_path/$id.ratelimit_errorpages.conf";

	my $http_to_https_redirect_conf = "$inc_path/${id}_http_to_https_redirect.conf";
	my $anubis_ssl_conf = "$inc_ssl_path/$id.conf";
	my $javascript_auto_dir = $repository->get_conf( "base_path" ) . "/archives/$id/cfg/static/javascript/auto/";
	my $uploadmethod_file_max_size = $javascript_auto_dir . "99_uploadmethod_file_max_size.js";

	my $securehost = $repository->get_conf( "securehost" );
	

	if( !$undo )
	{
		# all hosts will be on the same internal port with apache virtualhosts sorting them out after anubis forwards requests to $eprints_local_port (3000 by default)

		# separate out the logging commands so these can be easily manually altered, without fear that this script will overwrite them

		if(! -e $eprints_apachelog_conf){
			# there isn't a config file with logging yet
			my $logging_config_contents = "

# This file configures the apache logs of EPrints itself. Only requests passed through anubis to EPrints can make it this far.
# This file will not be overwritten by generate_apacheconf_for_anubis, so you can modify it.

ErrorLog /var/log/httpd/${id}_eprints_error.log
# also log response duration and anubis cookie presence, to aid analysing the impact
CustomLog /var/log/httpd/${id}_eprints_access.log \"%h %T %l %u %t \\\"%r\\\" %>s %b \\\"%{Accept-Language}i\\\" \\\"%{Referer}i\\\" \\\"%{User-agent}i\\\" \\\"%{techaro.lol-anubis-cookie-verification}C\\\"\"
#CustomLog /var/log/httpd/${id}_eprints_access.log combined
";
			EPrints->system->write_config_file( $eprints_apachelog_conf, $logging_config_contents );
		}

		if($ratelimit && !-e $ratelimit_errorpages_conf){
			# there isn't an errorpages override config file and we need one because ratelimiting is enabled
			`cp /opt/eprints3/ingredients/anubis/apache/503_error_handling.conf $ratelimit_errorpages_conf`
		}

		my $fake_repo = FakeRepo->new($repository, $eprints_local_port);
		my $new_config_contents = EPrints::Apache::apache_conf( $fake_repo );

		# add the secure option because we will be presented to the world on https, even if internally it's http
		$new_config_contents =~ s/PerlSetVar EPrints_ArchiveID $id/PerlSetVar EPrints_ArchiveID $id\n    PerlSetVar EPrints_Secure yes/;

		$new_config_contents =~ s/ServerAdmin/Include $eprints_apachelog_conf\n\n  ServerAdmin/;

		# add the following block to undo the proxy for remote-ip, so eprints can be blissfully unaware its behind a proxy
		# # Get the real remote IP back, otherwise all accesses appear to come from ::1
		#   <IfModule remoteip_module>
		#     RemoteIPHeader X-Real-Ip
		#     RemoteIPTrustedProxy ::1
		#   </IfModule>
		$new_config_contents =~ s@</VirtualHost>@  # Get the real remote IP back, otherwise all accesses appear to come from ::1\n  <IfModule remoteip_module>\n    RemoteIPHeader X-Real-Ip\n    RemoteIPTrustedProxy ::1\n  </IfModule>\n</VirtualHost>@;
		
		# do NOT include this legacy file as it can result in a redirect loop!
		my $apachevhost = $repository->config( "config_path" )."/apachevhost.conf";
		
		$new_config_contents =~ s/  # Include any legacy directives\n//;
		$new_config_contents =~ s/  Include $apachevhost\n\n//;

		my $backup = EPrints->system->write_config_file( $eprints_apache_conf_file, $new_config_contents );
		if( $backup )
		{
			print "Wrote $backup\n" if( $noise >= 1 );
		}
		print "Wrote $eprints_apache_conf_file\n" if( $noise >= 1 );
	}

	if( !$undo ){
		# if we're alreayd configured with HTTPS then this will be a simple redirect listening on port 80
		my $redirect_to_https = EPrints::Apache::apache_conf( $repository );

		my $backup = EPrints->system->write_config_file( $http_to_https_redirect_conf, $redirect_to_https );
		if( $backup )
		{
			print "Wrote $backup\n" if( $noise >= 1 );
		}
		print "Wrote $http_to_https_redirect_conf\n" if( $noise >= 1 );
	}else{
		#stolen from innards of EPrints->system->write_config_file
		my @now = localtime();
		my $newpath = sprintf("%s.%04d%02d%02d",
			$http_to_https_redirect_conf,
			$now[5]+1900,
			$now[4]+1,
			$now[3]
		);
		File::Copy::move($http_to_https_redirect_conf, $newpath);
		print "Moved $http_to_https_redirect_conf to $newpath\n" if $noise >= 1;
	}

	if( !$undo ){

		# block of config that should be included inside the <virtualhost> which is configured for ssl on port 443
		my $anubis =<<EOC;
# HTTPS listener that forwards to Anubis

# These headers need to be set or else Anubis will
# throw an "admin misconfiguration" error.
RequestHeader set "X-Real-Ip" expr=%{REMOTE_ADDR}
RequestHeader set X-Forwarded-Proto "https"
RequestHeader set "X-Http-Version" "%{SERVER_PROTOCOL}s"

ProxyPreserveHost On

ProxyRequests Off
ProxyVia Off
ProxyTimeout 300
EOC

		if($found_shibboleth){
			$anubis.=<<EOC;
# don't try and proxy shibboleth. Unsure why shib.conf isn't taking priority but this does fix it
ProxyPass /Shibboleth.sso !
ProxyPass /shibboleth !
ProxyPass /cgi/shibboleth !
EOC

		}
		$anubis.=<<EOC;
# Replace 8923 with the port Anubis listens on
ProxyPass / http://[::1]:8923/
ProxyPassReverse / http://[::1]:8923/

EOC
		if($ratelimit){
			$anubis.="

Include $ratelimit_errorpages_conf
";
		}
		my $backup = EPrints->system->write_config_file( $anubis_ssl_conf, $anubis );
		if( $backup )
		{
			print "Wrote $backup\n" if( $noise >= 1 );
		}
		print "Wrote $anubis_ssl_conf\n" if( $noise >= 1 );
	}

	# TODO review if we still need this in the anubis version of this script?
	my $max_size = $repository->get_conf( 'max_upload_filesize' );
	if(defined $max_size){
		my $js = "max_size = " . $repository->get_conf( 'max_upload_filesize' ) . ";";
		EPrints->system->mkdir( $javascript_auto_dir );
		EPrints->system->write_config_file( $uploadmethod_file_max_size, $js );
	}else{
		# older instances of EPrints don't have this in config. Just carry on
		print STDERR "max_upload_filesize not configured";
	}
}

if ($ratelimit && !$undo)
{
	#symlink default nginx config into place
	if( !-e $nginx_ratelimit_conf)
	{
		# this is the config for the reverse proxy between anubis and internal eprints
		# this is symlinked into the archive because so it's easy to replace with a copy if we need per-archive tweaks
		print "eprints_nginx_rate_limiting.conf not present, symlinking default\n";
		`mkdir -p $nginx_conf_dir`;
		`ln -s $base_path/ingredients/anubis/nginx/eprints_nginx_rate_limiting.conf $nginx_ratelimit_conf`;
		# File::Copy::copy("$base_path/ingredients/anubis/nginx/eprints_nginx_rate_limiting.conf", $nginx_ratelimit_conf);
	}
	else
	{
		if(! -l $nginx_ratelimit_conf)
		{
			print "$nginx_ratelimit_conf already present and isn't a symlink. You may want to double check this is still up to date\n";
		}
	}

	
}

# Note, not doing anything with the front facing nginx config since the configuration for a front facing apache server isn't included here so
# nor should the front facing nginx config. Instead a file will be provided in the repo (nginx_front_facing.conf) and it will be up to the user (or ansible)
# to configure nginx. Converting the SSL configuration from apache to nginx will almost certainly require manual intervention.


my $anubis_config_path = "/etc/anubis/eprints.env";
# Get what's after the last colon, which should be the port number
my $anubis_forwards_to_port = `awk -F ':' '/TARGET/{print \$NF}' $anubis_config_path`;
# strip whitespace. Because why would that be easy in perl?
$anubis_forwards_to_port =~ s/^\s*(.*?)\s*$/$1/;

my $anubis_should_forward_to_port = "$eprints_local_port";
my $ratelimit_is = "disabled";
if ($ratelimit){
	$anubis_should_forward_to_port = "$nginx_ratelimit_local_port";
	$ratelimit_is = "enabled";
}

if($anubis_forwards_to_port ne $anubis_should_forward_to_port)
{
	my $anubis_current_target = "internal eprints";
	if ($anubis_forwards_to_port eq "$nginx_ratelimit_local_port"){
		$anubis_current_target = "Nginx rate limiter";
	}
	print "\n\nAnubis is currently configured to forward to port $anubis_forwards_to_port ($anubis_current_target).\n";
	print "For rate limiting to be correctly $ratelimit_is you will need to edit $anubis_config_path and change TARGET=... to be TARGET=http://[::1]:$anubis_should_forward_to_port\n\n";
	if($ratelimit){
		print "You will also need to ensure nginx is configured to load /opt/eprints/archives/$default_repo_id/nginx/eprints.conf and is enabled and running\n";
	}
}


print "\nYou must reload apache for any changes to take effect!\n" if( $noise >= 1 );


